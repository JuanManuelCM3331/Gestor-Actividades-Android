<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- SEC-01: Excluir credenciales JWT y caché SQLite de respaldos en la nube y transferencias D2D -->
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
